# QueryVault — local environment contract. VALUES ARE INTENTIONALLY PLACEHOLDERS.
#
#   cp .env.example .env      # .env is git-ignored; fill it with real values
#
# Never commit .env. Never put a real key in this file. In production these are
# supplied by the platform secret store (ECS task definition -> AWS Secrets
# Manager), not by a file. See docs/DEPLOYMENT.md.
#
# ---------------------------------------------------------------------------
# Two tiers, and the boundary between them is a security boundary:
#
#   VITE_*          inlined into the client bundle by Vite at build time.
#                   PUBLIC. Assume anyone can read these in devtools.
#   everything else server-only. Read via process.env inside *.server.ts
#                   modules and API routes. NEVER prefix a secret with VITE_.
# ---------------------------------------------------------------------------

# --- Supabase: browser-safe (public, protected by Row Level Security) ------
# The publishable key is designed to be shipped to browsers. It is only safe
# because RLS is enabled on every table — it is not a substitute for RLS.
# URL and project id must refer to the SAME project as the keys below.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Social sign-in: browser-safe feature flag ------------------------------
# Set to "true" ONLY after enabling Google in Supabase Dashboard ->
# Authentication -> Providers AND adding this origin's `/chat` URL to the
# redirect allow-list. While unset the "Continue with Google" button is hidden,
# because an unconfigured provider makes it fail 100% of the time. Email +
# password sign-in is unaffected either way. The Google OAuth *client secret*
# belongs in the Supabase project config, never here.
VITE_ENABLE_GOOGLE_AUTH=false

# --- Supabase: server-side mirror of the same public values -----------------
# Server code cannot read import.meta.env, so the same non-secret values are
# also provided unprefixed for SSR, middleware and API routes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref

# --- Supabase: SECRET ------------------------------------------------------
# Bypasses Row Level Security entirely. Full read/write on every tenant's
# data. Used only by the ingestion worker and other server-authoritative
# writers. MUST NEVER be prefixed with VITE_, imported into a React component,
# logged, committed, or pasted into a bug report. If it is ever exposed,
# rotate it immediately in Supabase Dashboard -> Settings -> API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider: selection ------------------------------------------------
# Which provider `requireAiProvider()` resolves. One of:
#   openai              api.openai.com                    -> OPENAI_API_KEY
#   lovable             ai.gateway.lovable.dev            -> LOVABLE_API_KEY
#   openai-compatible   your own endpoint (vLLM, Ollama,  -> AI_API_KEY
#                       LiteLLM, Azure via a proxy)          + AI_BASE_URL
# If unset, the provider is inferred from whichever credential is present, so an
# existing single-provider deployment keeps working without this line.
AI_PROVIDER=openai

# --- AI provider: SECRET ---------------------------------------------------
# Credential for the chat + embedding provider. Server-only; the browser never
# sees it and never calls the provider directly. Without the key for the
# selected provider, ingestion fails at the embedding step and /api/chat
# returns a structured NOT_CONFIGURED — it does not crash the server.
# Set only the one matching AI_PROVIDER; leave the others empty.
OPENAI_API_KEY=
LOVABLE_API_KEY=
AI_API_KEY=

# --- AI provider: model overrides (optional) --------------------------------
# Each provider ships defaults, so these are only needed to override them or
# when AI_PROVIDER=openai-compatible, where there are no defaults to fall back
# on and the resolver fails closed until they are set.
#
# AI_EMBEDDING_DIMENSIONS must stay 3072: the database column is
# `halfvec(3072)` with an HNSW index. A provider returning a different width
# fails per-row at insert time, mid-ingestion, after the parse and chunk work
# has already been paid for — so it is validated up front instead.
# AI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-4o
# AI_UTILITY_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-large
# AI_EMBEDDING_DIMENSIONS=3072

# --- Ingestion worker: SECRET ----------------------------------------------
# Shared secret authorizing POST /api/public/worker-drain (the queue drain
# trigger) and the ?deep=1 health probe. Generate a fresh random value:
#   openssl rand -hex 32
# If unset, those endpoints stay unauthorized (fail-closed). Production's
# Supabase scheduler must hold the same value in Vault; see docs/DEPLOYMENT.md.
INGESTION_WORKER_SECRET=

# --- Runtime ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Release identifier surfaced in health output and telemetry. Set to the git
# SHA or image tag in CI.
QV_RELEASE=local

# --- Rate limits and concurrency (optional) --------------------------------
# Per-user limits enforced server-side. The defaults below are the values
# compiled into src/lib/rate-limits.ts; set a variable only to change one.
# Any unparseable or non-positive value falls back to the default rather than
# disabling the limit, so a typo cannot accidentally remove protection.
# QV_RATE_CHAT_PER_MIN=30
# QV_RATE_EMBED_PER_MIN=120
# QV_RATE_UPLOAD_PER_5MIN=12
# QV_RATE_CLIENT_ERROR_PER_5MIN=20
# Documents one user may have in flight through ingestion at once.
# QV_MAX_CONCURRENT_INGESTIONS=3

# --- Build-time only -------------------------------------------------------
# NOT a runtime variable and never set on a deployed container. It tells the
# build guard in vite.config.ts that a placeholder public config is deliberate
# — used by CI to prove the build compiles without holding real credentials.
# The resulting artifact ships an unusable key and must never be deployed. The
# guard still refuses the build if a VITE_ variable holds a service-role key,
# declared or not.
# QV_ALLOW_PLACEHOLDER_CONFIG=1
