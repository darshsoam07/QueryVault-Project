# QueryVault container environment contract — VALUES INTENTIONALLY EMPTY.
# Copy to .env.docker (git-ignored) and fill locally, or supply these through
# the ECS task definition (`secrets` -> AWS Secrets Manager) in production.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
#
# The server refuses to start if the required values below are missing or still
# hold placeholders, naming the offending variable. That is deliberate: an
# unusable Supabase configuration otherwise fails every request with
# `401 Invalid API key`, which reads as an authentication bug rather than a
# deployment one.

# --- server-only (never build args, never baked into image layers) --------
# Required. SUPABASE_PROJECT_ID is not read by application code; it is part of
# the contract because the boot validator cross-checks it against the URL and
# the key claims to catch a key issued for a different project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
INGESTION_WORKER_SECRET=
QV_RELEASE=local

# --- AI provider (server-only) --------------------------------------------
# openai | lovable | openai-compatible. Leave unset to infer from whichever
# credential below is filled in. Set only the matching key; the others are
# forwarded as empty strings and treated as unset.
#
# A missing AI key is a warning, not a boot failure: the server still serves
# auth, uploads and the UI, and /api/chat returns a structured NOT_CONFIGURED.
AI_PROVIDER=openai
OPENAI_API_KEY=
LOVABLE_API_KEY=
AI_API_KEY=

# Optional model overrides. Required only for AI_PROVIDER=openai-compatible,
# which has no defaults and fails closed until they are set.
# AI_EMBEDDING_DIMENSIONS must stay 3072 to match the halfvec(3072) column.
# AI_BASE_URL=
# AI_CHAT_MODEL=
# AI_UTILITY_MODEL=
# AI_EMBEDDING_MODEL=
# AI_EMBEDDING_DIMENSIONS=3072

# --- browser-safe (inlined into the client bundle at build time) ----------
# These are build arguments, not runtime values: Vite bakes them into the
# JavaScript served to browsers, so the image is environment-specific. Building
# without them now fails the build rather than producing an image that answers
# `401 Invalid API key` for every user.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- runtime knobs --------------------------------------------------------
PORT=3000
HOST=0.0.0.0
